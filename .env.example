# Copy this file to .env, then set secrets and any provider model identifiers.
FRONTEND_HOST_PORT=3000
FRONTEND_CONTAINER_PORT=8080
FRONTEND_TEST_PORT=5173
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST_PORT=8000
BACKEND_CONTAINER_PORT=8000
POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_PORT=5432
POSTGRES_IMAGE=postgres:17-alpine
PYTHON_IMAGE=python:3.12-slim-bookworm
NODE_IMAGE=node:22-bookworm-slim
NGINX_IMAGE=nginx:alpine
POSTGRES_DB=workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=replace-with-a-local-password
WORKBENCH_SERVICE__PORT=8000
WORKBENCH_SERVICE__HOST=0.0.0.0
WORKBENCH_SERVICE__CORS_ORIGINS=["http://localhost:3000"]
WORKBENCH_SERVICE__VERSION=0.1.0
WORKBENCH_DATABASE__HOST=postgres
WORKBENCH_DATABASE__PORT=5432
WORKBENCH_DATABASE__NAME=workbench
WORKBENCH_DATABASE__USER=workbench
WORKBENCH_DATABASE__PASSWORD=replace-with-a-local-password
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=2.0
ANALYZER_TMPFS_BYTES=67108864
FRONTEND_TMPFS_BYTES=67108864
NGINX_CACHE_TMPFS_BYTES=16777216
WORKBENCH_PROVIDERS__OPENAI__MODEL=
WORKBENCH_PROVIDERS__OPENAI__API_KEY=
WORKBENCH_PROVIDERS__ANTHROPIC__MODEL=
WORKBENCH_PROVIDERS__ANTHROPIC__API_KEY=
WORKBENCH_PROVIDERS__GROQ__MODEL=
WORKBENCH_PROVIDERS__GROQ__API_KEY=
WORKBENCH_PROVIDERS__GEMINI__MODEL=
WORKBENCH_PROVIDERS__GEMINI__API_KEY=
WORKBENCH_PROVIDERS__OLLAMA__MODEL=
WORKBENCH_PROVIDERS__OLLAMA__API_KEY=
WORKBENCH_PROVIDERS__OPENROUTER__MODEL=
WORKBENCH_PROVIDERS__OPENROUTER__API_KEY=
WORKBENCH_PROVIDERS__TOGETHER__MODEL=
WORKBENCH_PROVIDERS__TOGETHER__API_KEY=
WORKBENCH_API_BASE_URL=/api/v1
WORKBENCH_TELEMETRY_ENDPOINT=
