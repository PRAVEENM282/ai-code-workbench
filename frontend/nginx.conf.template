server {
  error_log /dev/stderr warn;
  listen ${FRONTEND_CONTAINER_PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  client_max_body_size 1m;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'" always;

  location /api/ {
    proxy_pass http://backend:${WORKBENCH_SERVICE__PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 65s;
  }

  location = /runtime-config.js {
    add_header Cache-Control "no-store" always;
    alias /tmp/runtime-config.js;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
